# Copy this file to .env and fill in real values. Never commit .env.
PORT=8000
NODE_ENV=development

# Local MongoDB:   mongodb://127.0.0.1:27017
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017

# Origins allowed to READ dashboard data (comma separated, no trailing slash).
# Leave empty locally. On Render set it to your Vercel URL, e.g. https://pathlight.vercel.app
CORS_ORIGIN=

# Only used by `npm run seed` (the origin the fake pages pretend to live on)
SEED_BASE_URL=http://localhost:8000
