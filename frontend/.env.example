# Local development: leave empty (Vite proxies /api to http://localhost:8000).
# Vercel (production): set to your Render backend, INCLUDING /api/v1, no trailing slash:
#   VITE_API_BASE_URL=https://your-backend.onrender.com/api/v1
# Vite bakes this value into the build, so changing it requires a redeploy.
VITE_API_BASE_URL=
